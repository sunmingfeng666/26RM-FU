set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ACTIVE_BOARD)
get_filename_component(ENERGY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED ACTIVE_BOARD)
    set(ACTIVE_BOARD master)
endif()
if(ACTIVE_BOARD STREQUAL "master")
    set(ENERGY_CPU "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard")
    set(ENERGY_LINKER "${ENERGY_ROOT}/wanwanwanfufu/dbus_switch_energy/fu_master/STM32F407XX_FLASH.ld")
elseif(ACTIVE_BOARD MATCHES "^(slave[1-7]|motor)$")
    set(ENERGY_CPU "-mcpu=cortex-m3 -mthumb")
    set(ENERGY_LINKER "${ENERGY_ROOT}/wanwanwanfufu/dbus_switch_energy/fu_${ACTIVE_BOARD}/STM32F103XX_FLASH.ld")
else()
    message(FATAL_ERROR "Invalid ACTIVE_BOARD: ${ACTIVE_BOARD}")
endif()
set(CMAKE_C_COMPILER arm-none-eabi-gcc)
set(CMAKE_CXX_COMPILER arm-none-eabi-g++)
set(CMAKE_ASM_COMPILER arm-none-eabi-gcc)
set(CMAKE_OBJCOPY arm-none-eabi-objcopy)
set(CMAKE_SIZE arm-none-eabi-size)
set(CMAKE_EXECUTABLE_SUFFIX_C .elf)
set(CMAKE_EXECUTABLE_SUFFIX_ASM .elf)
set(CMAKE_C_FLAGS_INIT "${ENERGY_CPU} -Wall -fdata-sections -ffunction-sections")
set(CMAKE_ASM_FLAGS_INIT "${ENERGY_CPU} -x assembler-with-cpp -MMD -MP")
set(CMAKE_C_FLAGS_DEBUG "-O0 -g3")
set(CMAKE_C_FLAGS_RELEASE "-Os -g0")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${ENERGY_CPU} -T\"${ENERGY_LINKER}\" --specs=nano.specs -Wl,-Map=EnergyFirmware.map,--gc-sections,--print-memory-usage")
set(TOOLCHAIN_LINK_LIBRARIES m)
