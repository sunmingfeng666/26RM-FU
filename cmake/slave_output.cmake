add_custom_command(TARGET ${CMAKE_PROJECT_NAME} POST_BUILD
    COMMAND ${CMAKE_OBJCOPY} -O ihex $<TARGET_FILE_NAME:${CMAKE_PROJECT_NAME}> $<TARGET_FILE_BASE_NAME:${CMAKE_PROJECT_NAME}>.hex
    COMMAND ${CMAKE_OBJCOPY} -O binary $<TARGET_FILE_NAME:${CMAKE_PROJECT_NAME}> $<TARGET_FILE_BASE_NAME:${CMAKE_PROJECT_NAME}>.bin
    WORKING_DIRECTORY "${CMAKE_BINARY_DIR}")
